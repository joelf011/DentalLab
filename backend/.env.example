# Copia este ficheiro para .env e preenche com os teus dados.
# O .env não vai para o Git, porque tem a palavra-passe.

# Porta onde a API fica a ouvir (http://localhost:3000)
PORT=3000

# Endereços dos sites React que podem usar a API (separados por vírgulas).
# O Vite usa a porta 5173; se correres o backoffice e o site ao mesmo tempo, o segundo fica na 5174.
# A app Flutter não precisa de estar aqui (isto só se aplica a navegadores).
CORS_ORIGENS=http://localhost:5173,http://localhost:5174

# Base de dados PostgreSQL (a que criaste no pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abd_lab_cd
DB_USER=postgres
DB_PASSWORD=a_tua_palavra_passe

# Segredo para assinar os tokens de login (JWT): um texto aleatório com pelo menos 32 caracteres.
# Sem ele (ou com menos de 32 caracteres) a API não arranca.
# Para gerar um, corre no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=

# Emails (recuperação da palavra-passe e formulário de contacto do site), por SMTP.
# Sem SMTP_HOST, os emails não são enviados: aparecem no terminal da API (serve para testar).
# Exemplo com o Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, o email da conta em SMTP_UTILIZADOR
# e uma "palavra-passe de aplicação" (Conta Google > Segurança) em SMTP_PALAVRA_PASSE.
SMTP_HOST=
SMTP_PORT=587
SMTP_UTILIZADOR=
SMTP_PALAVRA_PASSE=
# Quem aparece como remetente
EMAIL_REMETENTE=DentalLab <nao-responder@dentallab.local>
# Para onde vão as mensagens do formulário de contacto
EMAIL_LABORATORIO=geral@dentallab.local

# Endereço do site, para os links que vão nos emails (ex.: recuperar a palavra-passe)
URL_SITE=http://localhost:5173

# Pasta onde ficam os ficheiros enviados (fotografias, STL...). Por omissão: backend/ficheiros
PASTA_FICHEIROS=
