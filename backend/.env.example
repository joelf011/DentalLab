# Copia este ficheiro para .env e preenche com os teus dados.
# O .env não vai para o Git, porque tem a palavra-passe.

# Porta onde a API fica a ouvir (http://localhost:3000)
PORT=3000

# Base de dados PostgreSQL (a que criaste no pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentallab
DB_USER=postgres
DB_PASSWORD=a_tua_palavra_passe

# Segredo para assinar os tokens de login (JWT). Tem de ser um texto longo e aleatório.
# Para gerar um, corre no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=trocar_por_um_texto_longo_e_aleatorio
