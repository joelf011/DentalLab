npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Pastas de build de produção geradas pelo Vite
**/dist/
**/out/

# Caches de ferramentas, TypeScript e ESLint
.eslintcache
.stylelintcache
.vite/
.tsbuildinfo

# Arquivos de ambiente locais (Segurança de dados)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

