@startuml modeloconceptual
hide methods
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

' ---------- Utilizadores ----------

class Cargo {
  +designacao
}

class Utilizador {
  +nome
  +email
  +password
  +passwordTemporaria
  +ativo
  +dataAprovacao
}

class Cliente {
  +nome
  +NIF
  +moradaFaturacao
  +email
  +telefone
  +ativo
}

' ---------- Encomendas ----------

class OrdemTrabalho {
  +nomeMedicoResponsavel
  +nomePaciente
  +sexoPaciente
  +idadePaciente
  +dataProximaConsulta
  +observacoes
  +prazoEntrega
  +dataCriacao
  +dataAceitacao
  +dataInicio
  +dataConclusao
  +dataEntrega
  +motivoEspera
  +motivoRejeicao
}

class EstadoOrdem {
  +designacao
}

class MaterialRecebido {
  +descricao
  +observacoes
  +dataRececao
}

class Trabalho {
  +natureza
  +cor
  +dentes
}

' ---------- Modelos de trabalho (geridos pelo Admin) ----------

class TipoTrabalho {
  +nome
  +descricao
  +ativo
}

class Etapa {
  +nome
  +descricao
  +ativa
}

class EtapaTipoTrabalho {
  +ordem
}

class EtapaTrabalho {
  +nome
  +ordem
  +dataInicio
  +dataConclusao
}

' ---------- Documentação e comunicação ----------

class Ficheiro {
  +nome
  +localizacao
  +dataCarregamento
}

class TipoFicheiro {
  +designacao
}

class Comentario {
  +conteudo
  +dataCriacao
  +dataEdicao
}

class Notificacao {
  +mensagem
  +dataCriacao
  +dataLeitura
}

class RegistoAuditoria {
  +acao
  +entidadeAfetada
  +dataHora
  +valoresAnteriores
  +valoresPosteriores
}

' ---------- Associações ----------

Cargo "1" -- "0..*" Utilizador : tem
Cliente "0..1" -- "0..*" Utilizador : contas
Utilizador "0..1" -- "0..*" Utilizador : aprova

Cliente "1" -- "0..*" OrdemTrabalho : encomenda
Utilizador "1" -- "0..*" OrdemTrabalho : cria
Utilizador "0..1" -- "0..*" OrdemTrabalho : aceita
EstadoOrdem "1" -- "0..*" OrdemTrabalho : estado
OrdemTrabalho "1" *-- "0..*" MaterialRecebido : regista

OrdemTrabalho "1" *-- "1..*" Trabalho : contem
TipoTrabalho "1" -- "0..*" Trabalho : classifica

TipoTrabalho "1" *-- "1..*" EtapaTipoTrabalho : configura
Etapa "1" -- "0..*" EtapaTipoTrabalho : integra

Trabalho "1" *-- "1..*" EtapaTrabalho : percorre
Etapa "0..1" -- "0..*" EtapaTrabalho : copiadaDe
Utilizador "0..1" -- "0..*" EtapaTrabalho : responsavel

TipoFicheiro "1" -- "0..*" Ficheiro : tipo
OrdemTrabalho "0..1" -- "0..*" Ficheiro : partilhado
Trabalho "0..1" -- "0..*" Ficheiro : interno
Utilizador "1" -- "0..*" Ficheiro : carrega

OrdemTrabalho "0..1" -- "0..*" Comentario : partilhado
Trabalho "0..1" -- "0..*" Comentario : interno
Utilizador "1" -- "0..*" Comentario : publica

Utilizador "1" -- "0..*" Notificacao : recebe
OrdemTrabalho "0..1" -- "0..*" Notificacao : refere
Trabalho "0..1" -- "0..*" Notificacao : refere

Utilizador "0..1" -- "0..*" RegistoAuditoria : executa

note right of Utilizador
  Admin e Colaborador: internos, sem Cliente.
  Cliente: cada clínica é um utilizador
  ligado à sua entidade Cliente.
  Contas criadas pela clínica ficam pendentes
  até o Admin as aprovar. Contas recusadas ou
  desativadas podem ser reativadas.
end note

note right of Trabalho
  natureza: FISICO ou DIGITAL
  cor: escala VITA (ex.: A2)
  dentes: 1 ou mais números FDI (odontograma)
  As datas de início e fim pertencem à Ordem.
end note

note right of EstadoOrdem
  Visível pela clínica. O progresso interno
  de cada Trabalho é dado pelas suas etapas.
end note

note bottom of Ficheiro
  Pertence à Ordem (partilhado com a clínica)
  OU ao Trabalho (interno) — nunca aos dois.
  O mesmo se aplica ao Comentario.
end note

note bottom of EtapaTrabalho
  Cópia das etapas do TipoTrabalho no momento
  da criação do Trabalho. Alterações posteriores
  ao modelo não afetam trabalhos já criados.
  Etapa atual = primeira etapa por concluir.
  Visível apenas para o laboratório.
end note

@enduml
