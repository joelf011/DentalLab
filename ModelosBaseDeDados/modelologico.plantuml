
@startuml
hide methods
hide stereotypes
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false

entity "UTILIZADOR" as UTILIZADOR {
  * id : BIGINT <<PK>>
  --
  * nome : VARCHAR
  * email : VARCHAR <<UK>>
  * password_hash : VARCHAR
  * perfil : perfil_utilizador
  * ativo : BOOLEAN
}

entity "CLIENTE" as CLIENTE {
  * id : BIGINT <<PK>>
  --
  * utilizador_id : BIGINT <<FK, UK>>
  * nome : VARCHAR
  NIF : VARCHAR <<UK>>
  morada_faturacao : VARCHAR
  email : VARCHAR
  telefone : VARCHAR
  * ativo : BOOLEAN
}

entity "COLABORADOR" as COLABORADOR {
  * id : BIGINT <<PK>>
  --
  * utilizador_id : BIGINT <<FK, UK>>
  * nome : VARCHAR
  * ativo : BOOLEAN
}

entity "ORDEM_TRABALHO" as ORDEM_TRABALHO {
  * id : BIGINT <<PK>>
  --
  * cliente_id : BIGINT <<FK>>
  * criado_por : BIGINT <<FK>>
  * data_criacao : TIMESTAMPTZ
  data_envio : TIMESTAMPTZ
  * prazo_entrega : DATE
  * estado : estado_ordem
  nome_paciente : VARCHAR
  idade_paciente : SMALLINT
  data_aceitacao : TIMESTAMPTZ
  data_conclusao : TIMESTAMPTZ
  motivo_espera : TEXT
  motivo_rejeicao : TEXT
}

entity "TIPO_TRABALHO" as TIPO_TRABALHO {
  * id : BIGINT <<PK>>
  --
  * nome : VARCHAR <<UK>>
  descricao : TEXT
  * ativo : BOOLEAN
}

entity "TRABALHO" as TRABALHO {
  * id : BIGINT <<PK>>
  --
  * ordem_trabalho_id : BIGINT <<FK>>
  * tipo_trabalho_id : BIGINT <<FK>>
  * nome_medico_responsavel : VARCHAR
  * natureza : natureza_trabalho
  cor : VARCHAR
  * estado : estado_trabalho
  data_inicio : TIMESTAMPTZ
  data_conclusao : TIMESTAMPTZ
  data_entrega : TIMESTAMPTZ
}

entity "DENTE" as DENTE {
  * id : BIGINT <<PK>>
  --
  * numero_fdi : SMALLINT <<UK>>
}

entity "TRABALHO_DENTE" as TRABALHO_DENTE {
  * trabalho_id : BIGINT <<PK, FK>>
  * dente_id : BIGINT <<PK, FK>>
}

entity "ETAPA" as ETAPA {
  * id : BIGINT <<PK>>
  --
  * nome : VARCHAR
  descricao : TEXT
  * acao_sistema : acao_sistema_etapa
  * ativa : BOOLEAN
}

entity "ETAPA_TIPO_TRABALHO" as ETAPA_TIPO_TRABALHO {
  * tipo_trabalho_id : BIGINT <<PK, FK>>
  * etapa_id : BIGINT <<PK, FK>>
  --
  * ordem_sequencia : INTEGER
  * obrigatoria : BOOLEAN
}

entity "ETAPA_TRABALHO" as ETAPA_TRABALHO {
  * id : BIGINT <<PK>>
  --
  * trabalho_id : BIGINT <<FK>>
  etapa_origem_id : BIGINT <<FK>>
  responsavel_atual_id : BIGINT <<FK>>
  * nome_etapa : VARCHAR
  * ordem_sequencia : INTEGER
  * acao_sistema : acao_sistema_etapa
  * estado : estado_etapa
  data_inicio : TIMESTAMPTZ
  data_conclusao : TIMESTAMPTZ
  motivo_salto : TEXT
}

entity "HISTORICO_RESPONSABILIDADE" as HISTORICO_RESPONSABILIDADE {
  * id : BIGINT <<PK>>
  --
  * etapa_trabalho_id : BIGINT <<FK>>
  * colaborador_id : BIGINT <<FK>>
  * data_atribuicao : TIMESTAMPTZ
  data_fim : TIMESTAMPTZ
  observacoes : TEXT
}

entity "MATERIAL_RECEBIDO" as MATERIAL_RECEBIDO {
  * id : BIGINT <<PK>>
  --
  * trabalho_id : BIGINT <<FK>>
  * descricao : TEXT
  observacoes : TEXT
}

entity "FICHEIRO" as FICHEIRO {
  * id : BIGINT <<PK>>
  --
  * trabalho_id : BIGINT <<FK>>
  * carregado_por : BIGINT <<FK>>
  * nome : VARCHAR
  * localizacao : TEXT
  * tipo : VARCHAR
  * visibilidade : visibilidade_conteudo
  * data_carregamento : TIMESTAMPTZ
}

entity "FOTOGRAFIA" as FOTOGRAFIA {
  * id : BIGINT <<PK>>
  --
  * trabalho_id : BIGINT <<FK>>
  * carregado_por : BIGINT <<FK>>
  * localizacao : TEXT
  descricao : TEXT
  * visibilidade : visibilidade_conteudo
  * data_carregamento : TIMESTAMPTZ
}

entity "COMENTARIO" as COMENTARIO {
  * id : BIGINT <<PK>>
  --
  * trabalho_id : BIGINT <<FK>>
  * utilizador_id : BIGINT <<FK>>
  comentario_pai_id : BIGINT <<FK>>
  * visibilidade : visibilidade_conteudo
  * conteudo : TEXT
  * data_criacao : TIMESTAMPTZ
  data_edicao : TIMESTAMPTZ
}

entity "REGISTO_AUDITORIA" as REGISTO_AUDITORIA {
  * id : BIGINT <<PK>>
  --
  * utilizador_id : BIGINT <<FK>>
  * acao : VARCHAR
  * entidade_afetada : VARCHAR
  * id_entidade_afetada : VARCHAR
  * data_hora : TIMESTAMPTZ
  valores_anteriores : JSONB
  valores_posteriores : JSONB
}


UTILIZADOR ||--o| CLIENTE : conta_partilhada
UTILIZADOR ||--o| COLABORADOR : login_individual

CLIENTE ||--o{ ORDEM_TRABALHO : encomendas
UTILIZADOR ||--o{ ORDEM_TRABALHO : cria

ORDEM_TRABALHO ||--|{ TRABALHO : contem
TIPO_TRABALHO ||--o{ TRABALHO : classifica

TRABALHO ||--o{ TRABALHO_DENTE
DENTE ||--o{ TRABALHO_DENTE

TIPO_TRABALHO ||--|{ ETAPA_TIPO_TRABALHO : configura
ETAPA ||--o{ ETAPA_TIPO_TRABALHO : integra

TRABALHO ||--|{ ETAPA_TRABALHO : percorre
ETAPA |o--o{ ETAPA_TRABALHO : modelo

COLABORADOR |o--o{ ETAPA_TRABALHO : responsavel_atual
ETAPA_TRABALHO ||--o{ HISTORICO_RESPONSABILIDADE : historico
COLABORADOR ||--o{ HISTORICO_RESPONSABILIDADE : atribuido

TRABALHO ||--o{ MATERIAL_RECEBIDO : regista
TRABALHO ||--o{ FICHEIRO : inclui
TRABALHO ||--o{ FOTOGRAFIA : inclui

UTILIZADOR ||--o{ FICHEIRO : carrega
UTILIZADOR ||--o{ FOTOGRAFIA : carrega

TRABALHO ||--o{ COMENTARIO : recebe
UTILIZADOR ||--o{ COMENTARIO : publica
COMENTARIO |o--o{ COMENTARIO : respostas

UTILIZADOR ||--o{ REGISTO_AUDITORIA : executa

note right of ORDEM_TRABALHO
  A clínica é obrigatória.
  O paciente pode ser anónimo.
  Só ADMIN ou CLIENTE pode criar.
end note

note right of UTILIZADOR
  ADMIN: login individual.
  COLABORADOR: login individual.
  CLIENTE: conta partilhada da clínica.
end note

@enduml
